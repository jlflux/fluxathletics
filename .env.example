# Environment variables for password-based publishing from /admin.html.
# Set these on your host (Vercel/Cloudflare dashboard), NOT in a committed file.
# Without them the admin still works, falling back to a pasted GitHub token.

# Password you type in the admin. Make it long and random — a single edge
# instance cannot rate-limit guesses reliably on its own.
ADMIN_PASSWORD=

# Random string used to sign the session cookie. Generate one with:
#   openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=

# Fine-grained GitHub token. Repository access: "Only select repositories"
# -> this repo. Permissions -> Repository -> Contents: "Read and write".
# This never reaches the browser.
GITHUB_TOKEN=

# Where Publish commits to.
GITHUB_OWNER=jlflux
GITHUB_REPO=fluxathletics
GITHUB_BRANCH=main
